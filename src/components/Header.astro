---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/logo-trim.png';
import LanguageSwitch from './LanguageSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import { sections } from '../config/sections';
import { t, homePath, navHref, sectionHref, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang, page = '' } = Astro.props;
const d = t(lang);
const home = homePath(lang);
// En el menú de escritorio se muestran las secciones principales, como en Stitch.
const desktopNav = sections.filter((s) => ['rutas', 'galeria', 'como-llegar', 'cafe'].includes(s.id));
---

<header class="fixed inset-x-0 top-0 z-50 bg-surface/90 pt-[env(safe-area-inset-top)] shadow-[0_1px_8px_rgba(28,20,13,0.06)] backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-space-sm xl:h-20">
    <a href={home} class="group flex min-w-0 items-center gap-space-sm xl:gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-surface-container-lowest p-1 shadow-sm transition-transform duration-300 group-hover:scale-105 xl:h-12 xl:w-12">
        <Image src={logo} alt={d.a11y.logoAlt} width={96} class="h-full w-full object-contain" loading="eager" />
      </span>
      <span class="flex min-w-0 flex-col">
        <span class="font-headline-sm text-[16px] leading-none font-semibold text-primary xl:text-headline-sm xl:leading-none">RÍO TÉLLEZ</span>
        <span class="mt-1 truncate font-label-caps text-[9px] tracking-wider text-on-surface-variant uppercase xl:text-label-caps">{d.header.tagline}</span>
      </span>
    </a>

    <nav aria-label={d.a11y.mainNav} class="hidden items-center gap-space-lg xl:flex">
      {
        desktopNav.map((s) => (
          <a
            href={navHref(s.id, lang)}
            aria-current={page === 'galeria' && s.id === 'galeria' ? 'page' : undefined}
            class="py-space-xs font-label-lg text-label-lg tracking-wider text-on-surface-variant uppercase transition-colors hover:text-primary aria-[current=page]:text-primary aria-[current=page]:underline aria-[current=page]:underline-offset-8"
          >
            {d.nav[s.label]}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-space-xs xl:gap-space-md">
      <LanguageSwitch lang={lang} page={page} />
      <a
        href={sectionHref('reservas', lang)}
        class="hidden items-center justify-center rounded-lg bg-secondary px-5 py-2.5 font-label-lg text-label-lg tracking-wider text-on-secondary uppercase shadow-sm transition-all hover:-translate-y-0.5 hover:bg-on-secondary-fixed-variant sm:inline-flex"
      >
        {d.header.cta}
      </a>
      <button
        type="button"
        class="flex min-h-11 min-w-11 items-center justify-center rounded-lg text-primary-container transition-colors hover:text-primary xl:hidden"
        aria-label={d.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-open
      >
        <Icon name="material-symbols:menu" class="h-6 w-6" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<MobileMenu lang={lang} />
