---
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="origen" aria-labelledby="origen-title" class="w-full bg-surface-container-low py-space-xl lg:py-28">
  <div class="container-site flex flex-col gap-space-lg lg:gap-16">
    <div class="flex flex-col gap-space-sm md:flex-row md:items-end md:justify-between md:gap-6">
      <div class="max-w-xl">
        <p class="mb-2 inline-flex items-center gap-1.5 text-secondary">
          <Icon name="material-symbols:nature-outline" class="h-[18px] w-[18px]" aria-hidden="true" />
          <span class="font-label-caps text-label-caps tracking-widest uppercase">{d.essence.eyebrow}</span>
        </p>
        <h2 id="origen-title" class="font-headline-md text-headline-md text-primary lg:font-headline-lg lg:text-headline-lg">
          {d.essence.title}
        </h2>
      </div>
      <div class="mt-2 max-w-md space-y-2 rounded-xl border border-surface-container bg-surface p-space-md text-on-surface-variant shadow-sm md:mt-0 md:border-0 md:bg-transparent md:p-0 md:shadow-none">
        <p class="font-body-md text-body-md leading-relaxed">
          <strong class="font-semibold text-primary">{site.legalName.toUpperCase()}</strong>
          <span class="whitespace-nowrap"> (NIT: {site.nit})</span>
          {' '}{d.essence.intro}
        </p>
        <p class="font-body-md text-body-md leading-relaxed">{d.essence.text}</p>
      </div>
    </div>

    <ul class="grid grid-cols-1 gap-space-sm sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {
        d.essence.pillars.map((p) => (
          <li class="group flex items-start gap-space-md rounded-xl bg-surface p-space-md shadow-sm transition-shadow hover:shadow-md lg:flex-col lg:gap-0 lg:p-8">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary-container text-on-primary transition-transform group-hover:scale-110 lg:mb-6 lg:h-14 lg:w-14 lg:rounded-full lg:bg-primary-container/10 lg:text-primary">
              <Icon name={p.icon} class="h-6 w-6 lg:h-7 lg:w-7" aria-hidden="true" />
            </span>
            <div class="flex min-w-0 flex-1 flex-col">
              <span class="font-label-caps text-label-caps tracking-widest text-secondary uppercase">{p.tag}</span>
              <h3 class="mt-0.5 font-headline-sm text-headline-sm text-primary lg:mb-2">{p.title}</h3>
              <p class="font-label-lg text-label-lg text-on-surface-variant lg:mb-3">{p.subtitle}</p>
              <p class="mt-1 font-caption text-caption leading-normal text-on-surface-variant lg:mt-auto lg:font-body-md lg:text-body-md">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="flex items-start gap-4 rounded-xl bg-primary-container p-space-md text-on-primary shadow-md lg:items-center lg:gap-5 lg:rounded-2xl lg:p-10">
      <Icon name="material-symbols:spa-outline" class="h-8 w-8 shrink-0 text-tertiary-fixed lg:h-10 lg:w-10" aria-hidden="true" />
      <div>
        <p class="font-headline-sm text-[18px] leading-snug font-semibold text-surface lg:text-headline-sm">{d.essence.stripTitle}</p>
        <p class="mt-1 font-caption text-caption text-on-primary-container lg:font-body-md lg:text-body-md">{d.essence.stripText}</p>
      </div>
    </div>
  </div>
</section>
