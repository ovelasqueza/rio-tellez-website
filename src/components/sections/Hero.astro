---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heroImg from '../../assets/images/hero-canon.jpg';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section
  aria-labelledby="hero-title"
  class="relative flex w-full items-center overflow-hidden bg-primary-container pt-16 xl:min-h-[92vh] xl:justify-center xl:pt-20"
>
  <div class="pointer-events-none absolute inset-0">
    <Picture
      src={heroImg}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1376]}
      quality={60}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-center opacity-45 xl:scale-105 xl:opacity-100 xl:brightness-90"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-primary/80 via-primary-container/85 to-primary xl:from-primary/80 xl:via-primary/30 xl:to-primary/95"></div>
  </div>

  <div class="relative z-10 container-site flex flex-col gap-space-md pt-space-lg pb-space-xl xl:items-center xl:pt-24 xl:pb-16 xl:text-center">
    <p class="inline-flex items-center gap-1.5 self-start rounded-full bg-surface/15 px-space-sm py-1 shadow-sm backdrop-blur-md xl:self-center xl:px-4 xl:py-1.5">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-secondary-container xl:h-2 xl:w-2"></span>
      <span class="font-label-caps text-label-caps tracking-wider text-primary-fixed uppercase">{d.hero.badge}</span>
    </p>

    <h1
      id="hero-title"
      class="max-w-4xl font-headline-lg-mobile text-headline-lg-mobile text-surface-container-lowest drop-shadow-md sm:font-display-hero-mobile sm:text-display-hero-mobile xl:font-display-hero xl:text-display-hero"
    >
      {d.hero.title}
    </h1>

    <p class="max-w-2xl pt-1 font-body-md text-body-md text-on-primary-container xl:text-subhead xl:font-normal">
      {d.hero.text}
    </p>

    <div class="flex flex-col gap-2.5 pt-space-xs sm:flex-row xl:gap-4 xl:pt-space-md">
      <a
        href="#reservas"
        class="flex min-h-12 items-center justify-center gap-2 rounded-lg bg-secondary px-8 py-3 font-label-lg text-label-lg tracking-wider text-on-secondary uppercase shadow-md transition-all hover:-translate-y-0.5 hover:bg-on-secondary-fixed-variant active:scale-[0.98]"
      >
        <Icon name="material-symbols:hiking" class="h-5 w-5" aria-hidden="true" />
        {d.hero.ctaBooking}
      </a>
      <a
        href="#cafe"
        class="flex min-h-12 items-center justify-center gap-2 rounded-lg bg-surface px-8 py-3 font-label-lg text-label-lg tracking-wider text-primary uppercase shadow-sm transition-all hover:-translate-y-0.5 hover:bg-surface-container-low active:scale-[0.98] xl:order-first"
      >
        <Icon name="material-symbols:local-cafe-outline" class="h-5 w-5" aria-hidden="true" />
        {d.hero.ctaCoffee}
      </a>
    </div>
  </div>
</section>
