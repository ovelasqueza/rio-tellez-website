---
/**
 * Panel administrativo. Página estática; los datos se cargan desde /api/admin/*
 * (Cloudflare Pages Functions) y TODO /admin + /api/admin está protegido por Cloudflare Access.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { galleryCategories } from '../../config/gallery';
import { getGalleryPhotos } from '../../lib/gallery';
import heroImg from '../../assets/images/hero-canon.jpg';
import { t } from '../../i18n';

const labels = t('es').gallery.categories;
const defaultHeroImg = await getImage({ src: heroImg, width: 800, format: 'webp', quality: 60 });

// Miniaturas de las fotos que aún viven en el repositorio (para verlas en el panel).
const localGallery: Record<string, { thumb: string; repoPath: string; width: number; height: number }> = {};
for (const p of await getGalleryPhotos()) {
  if (p.source.kind !== 'local' || !p.repoPath) continue;
  const img = await getImage({ src: p.source.image, width: Math.min(480, p.source.width), format: 'webp', quality: 60 });
  localGallery[p.id] = { thumb: img.src, repoPath: p.repoPath, width: p.source.width, height: p.source.height };
}

const expFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/experiencias/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const localExperienceThumbs: Record<string, string> = {};
for (const [path, mod] of Object.entries(expFiles)) {
  const img = await getImage({ src: mod.default, width: Math.min(640, mod.default.width), format: 'webp', quality: 60 });
  // Mismo formato que en los YAML: "../../assets/images/experiencias/x.jpg"
  localExperienceThumbs[path.replace(/^\/src\//, '../../')] = img.src;
}

const buildData = {
  categories: Object.fromEntries(galleryCategories.map((c) => [c, labels[c]])),
  localGallery,
  localExperienceThumbs,
  defaultHeroThumb: defaultHeroImg.src,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel · Río Téllez</title>
    <link rel="icon" type="image/png" href="/favicon-32.png" />
  </head>
  <body>
    <header class="adm-top">
      <div class="adm-brand">
        <strong>Río Téllez</strong>
        <span>Panel administrativo</span>
      </div>
      <div class="adm-top-actions">
        <span id="adm-user" class="adm-muted"></span>
        <a href="/" target="_blank" rel="noopener" class="adm-btn adm-btn--small">Ver sitio</a>
        <button type="button" id="adm-logout-btn" class="adm-btn adm-btn--small" hidden>Salir</button>
      </div>
    </header>

    <nav class="adm-tabs" role="tablist" aria-label="Secciones">
      <button type="button" role="tab" data-tab="gallery" aria-selected="true">Galería <i data-dirty-dot="gallery" hidden></i></button>
      <button type="button" role="tab" data-tab="experiences" aria-selected="false">Experiencias <i data-dirty-dot="experiences" hidden></i></button>
      <button type="button" role="tab" data-tab="site" aria-selected="false">Datos del sitio <i data-dirty-dot="site" hidden></i></button>
    </nav>

    <main id="adm-panel" class="adm-main">
      <p class="adm-loading">Cargando…</p>
    </main>

    <dialog id="adm-dialog" class="adm-dialog"></dialog>
    <div id="adm-toasts" class="adm-toasts" aria-live="polite"></div>

    <script type="application/json" id="admin-build-data" set:html={JSON.stringify(buildData)} />
    <script>
      import '../../scripts/admin/app';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --adm-primary: #00261a;
    --adm-primary-2: #1d4a3a;
    --adm-accent: #8a4b16;
    --adm-bg: #fff8f3;
    --adm-surface: #ffffff;
    --adm-line: #eadcc6;
    --adm-text: #221a0b;
    --adm-muted: #5d6460;
    --adm-danger: #b3261e;
    --adm-radius: 12px;
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font: 15px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: var(--adm-bg);
    color: var(--adm-text);
  }
  [hidden] {
    display: none !important;
  }
  .adm-top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--adm-primary);
    color: #fff;
  }
  .adm-brand {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .adm-brand span {
    font-size: 12px;
    opacity: 0.75;
  }
  .adm-top-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .adm-top .adm-muted {
    color: #cfe3da;
    font-size: 13px;
  }
  .adm-top .adm-btn {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .adm-tabs {
    position: sticky;
    top: 56px;
    z-index: 15;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 8px 16px 0;
    background: var(--adm-bg);
    border-bottom: 1px solid var(--adm-line);
  }
  .adm-tabs button {
    position: relative;
    padding: 10px 14px;
    border: 0;
    border-bottom: 3px solid transparent;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--adm-muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .adm-tabs button[aria-selected='true'] {
    color: var(--adm-primary);
    border-bottom-color: var(--adm-accent);
  }
  .adm-tabs i {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 4px;
    border-radius: 50%;
    background: var(--adm-accent);
    vertical-align: middle;
  }
  .adm-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .adm-loading,
  .adm-empty {
    color: var(--adm-muted);
    padding: 24px;
    text-align: center;
    list-style: none;
    grid-column: 1 / -1;
  }
  .adm-savebar {
    position: sticky;
    top: 104px;
    z-index: 10;
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--adm-surface);
    border: 1px solid var(--adm-line);
    border-radius: var(--adm-radius);
    box-shadow: 0 4px 16px rgba(34, 26, 11, 0.06);
  }
  .adm-savebar h2 {
    margin: 0;
    font-size: 20px;
    color: var(--adm-primary);
  }
  .adm-savebar p {
    margin: 2px 0 0;
    font-size: 13px;
  }
  .adm-muted {
    color: var(--adm-muted);
  }
  .adm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--adm-line);
    border-radius: 10px;
    background: var(--adm-surface);
    color: var(--adm-primary);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .adm-btn:hover:not(:disabled) {
    border-color: var(--adm-primary-2);
  }
  .adm-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .adm-btn--primary {
    background: var(--adm-primary);
    border-color: var(--adm-primary);
    color: #fff;
  }
  .adm-btn--primary:hover:not(:disabled) {
    background: var(--adm-primary-2);
  }
  .adm-btn--danger {
    color: var(--adm-danger);
  }
  .adm-btn--small {
    min-height: 32px;
    padding: 4px 10px;
    font-size: 13px;
  }
  .adm-icon {
    width: 32px;
    height: 32px;
    border: 1px solid var(--adm-line);
    border-radius: 8px;
    background: var(--adm-surface);
    cursor: pointer;
    font-size: 15px;
  }
  .adm-drop {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
    padding: 16px;
    border: 2px dashed var(--adm-line);
    border-radius: var(--adm-radius);
    background: var(--adm-surface);
  }
  .adm-drop.is-over {
    border-color: var(--adm-accent);
    background: #fff2e0;
  }
  .adm-drop p {
    flex-basis: 100%;
    margin: 0;
    font-size: 13px;
  }
  #adm-upload-progress {
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #adm-upload-progress:empty {
    display: none;
  }
  .adm-upload-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 13px;
  }
  .adm-upload-row progress {
    flex: 1;
    min-width: 120px;
  }
  .adm-upload-row--error {
    color: var(--adm-danger);
  }
  .adm-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .adm-chip {
    min-height: 34px;
    padding: 4px 12px;
    border: 1px solid var(--adm-line);
    border-radius: 999px;
    background: var(--adm-surface);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .adm-chip[aria-pressed='true'] {
    background: var(--adm-primary);
    border-color: var(--adm-primary);
    color: #fff;
  }
  .adm-chip span {
    opacity: 0.7;
  }
  .adm-pill {
    margin-left: auto;
    padding: 4px 10px;
    border-radius: 999px;
    background: #e6efe9;
    color: var(--adm-primary);
    font-size: 13px;
    font-weight: 600;
  }
  .adm-pill.is-warn {
    background: #fde7d2;
    color: var(--adm-accent);
  }
  .adm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .adm-card {
    list-style: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--adm-line);
    border-radius: var(--adm-radius);
    background: var(--adm-surface);
  }
  .adm-card-img {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    background: #f1e0c7;
    cursor: pointer;
  }
  .adm-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .adm-noimg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--adm-muted);
    font-size: 13px;
  }
  .adm-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 8px;
    border-radius: 6px;
    background: rgba(0, 38, 26, 0.85);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .adm-badge--src {
    left: auto;
    right: 8px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--adm-muted);
  }
  .adm-badge--src.is-cloud {
    color: #1565c0;
  }
  .adm-card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
  }
  .adm-card-title {
    margin: 0;
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .adm-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .adm-row--actions {
    gap: 4px;
  }
  .adm-row--actions .adm-btn--danger {
    margin-left: auto;
  }
  .adm-row--fields > * {
    flex: 1 1 180px;
  }
  .adm-check {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    font-size: 13px;
    cursor: pointer;
  }
  .adm-check input {
    width: 18px;
    height: 18px;
    accent-color: var(--adm-primary);
  }
  .adm-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .adm-field--inline {
    min-width: 220px;
  }
  .adm-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--adm-primary);
  }
  .adm-req {
    color: var(--adm-danger);
  }
  .adm-hint {
    color: var(--adm-muted);
    font-size: 12px;
  }
  .adm-loc {
    display: flex;
    gap: 6px;
    align-items: flex-start;
  }
  .adm-lang {
    flex: 0 0 28px;
    padding-top: 9px;
    font-size: 11px;
    font-weight: 700;
    color: var(--adm-muted);
  }
  input[type='text'],
  input[type='number'],
  input[type='url'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    min-height: 38px;
    padding: 7px 10px;
    border: 1px solid var(--adm-line);
    border-radius: 8px;
    background: #fff;
    font: inherit;
    color: inherit;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--adm-primary-2);
    outline-offset: 0;
    border-color: transparent;
  }
  textarea {
    resize: vertical;
  }
  .adm-dialog {
    width: min(720px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    padding: 0;
    border: 0;
    border-radius: var(--adm-radius);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }
  .adm-dialog::backdrop {
    background: rgba(0, 20, 14, 0.55);
  }
  .adm-dialog-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
  }
  .adm-dialog-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .adm-dialog-head h3 {
    margin: 0;
    color: var(--adm-primary);
  }
  .adm-dialog-img {
    width: 100%;
    max-height: 320px;
    object-fit: contain;
    background: #f1e0c7;
    border-radius: 8px;
  }
  .adm-exp-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .adm-exp {
    border: 1px solid var(--adm-line);
    border-radius: var(--adm-radius);
    background: var(--adm-surface);
    overflow: hidden;
  }
  .adm-exp summary {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    cursor: pointer;
  }
  .adm-exp summary img,
  .adm-exp summary .adm-noimg {
    width: 72px;
    height: 54px;
    flex: 0 0 72px;
    object-fit: cover;
    border-radius: 8px;
    background: #f1e0c7;
  }
  .adm-exp-title {
    display: flex;
    flex-direction: column;
  }
  .adm-exp-form {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 16px;
    padding: 16px;
    border-top: 1px solid var(--adm-line);
  }
  .adm-exp-photo {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .adm-exp-photo img,
  .adm-exp-photo .adm-noimg {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    background: #f1e0c7;
  }
  .adm-exp-fields {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .adm-exp-fields > .adm-btn--danger {
    align-self: flex-start;
  }
  .adm-includes {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .adm-include {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .adm-include > .adm-field {
    flex: 1;
  }
  .adm-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--adm-line);
    border-radius: var(--adm-radius);
    background: var(--adm-surface);
  }
  .adm-group legend {
    padding: 0 6px;
    font-weight: 700;
    color: var(--adm-primary);
  }
  .adm-error {
    padding: 24px;
    border: 1px solid #f2c4c0;
    border-radius: var(--adm-radius);
    background: #fff;
  }
  .adm-error h2 {
    margin-top: 0;
    color: var(--adm-danger);
  }
  .adm-toasts {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: min(420px, calc(100vw - 32px));
  }
  .adm-toast {
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--adm-primary);
    color: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    font-size: 14px;
  }
  .adm-toast a {
    color: #ffd8a8;
    font-weight: 600;
  }
  .adm-toast--error {
    background: var(--adm-danger);
  }
  .adm-toast--info {
    background: #37474f;
  }
  @media (max-width: 720px) {
    .adm-tabs,
    .adm-savebar {
      position: static;
    }
    .adm-savebar {
      flex-direction: column;
      align-items: stretch;
    }
    .adm-exp-form {
      grid-template-columns: 1fr;
    }
  }
</style>
